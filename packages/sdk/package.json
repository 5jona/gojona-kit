{
  "name": "@gojona/sideveil-sdk",
  "version": "0.1.1",
  "description": "React plugin SDK and typed RPC/event/HUD/container hooks for SideVeil Android sidebar plugins.",
  "license": "MIT",
  "author": "5jona",
  "repository": {
    "type": "git",
    "url": "https://github.com/5jona/gojona-kit.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/5jona/gojona-kit#readme",
  "bugs": {
    "url": "https://github.com/5jona/gojona-kit/issues"
  },
  "keywords": [
    "sideveil",
    "sdk",
    "react",
    "plugin",
    "android",
    "webview"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import @gojona/config/register-ts --test test/*.test.mjs"
  },
  "dependencies": {
    "@gojona/bridge": "workspace:^",
    "@gojona/ui": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gojona/config": "workspace:*",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
