{
  "name": "@gojona/config",
  "version": "0.1.0",
  "description": "Shared Vite + React + Tailwind v4 preset, Biome config, Node TS test hook, and theme bootstrap SSOT for pochita-webui-kit.",
  "license": "MIT",
  "author": "5jona",
  "repository": {
    "type": "git",
    "url": "https://github.com/5jona/pochita-webui-kit.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/5jona/pochita-webui-kit#readme",
  "bugs": {
    "url": "https://github.com/5jona/pochita-webui-kit/issues"
  },
  "keywords": [
    "vite",
    "biome",
    "tailwindcss",
    "react",
    "theme",
    "webui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./index.d.ts",
  "files": [
    "biome.base.json",
    "index.d.ts",
    "index.mjs",
    "register-ts.mjs",
    "themes.d.ts",
    "themes.mjs"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./biome.json": "./biome.base.json",
    "./register-ts": "./register-ts.mjs",
    "./themes": {
      "types": "./themes.d.ts",
      "import": "./themes.mjs",
      "default": "./themes.mjs"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
