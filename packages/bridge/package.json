{
  "name": "@gojona/bridge",
  "version": "0.1.1",
  "description": "Runtime-aware transport bridge for Android WebView hosts, KernelSU WebUI, and browser mock environments with observability tracing.",
  "license": "MIT",
  "author": "5jona",
  "repository": {
    "type": "git",
    "url": "https://github.com/5jona/gojona-kit.git",
    "directory": "packages/bridge"
  },
  "homepage": "https://github.com/5jona/gojona-kit#readme",
  "bugs": {
    "url": "https://github.com/5jona/gojona-kit/issues"
  },
  "keywords": [
    "bridge",
    "webview",
    "kernelsu",
    "json-rpc",
    "react",
    "sideveil"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import @gojona/config/register-ts --test test/*.test.mjs"
  },
  "dependencies": {
    "@gojona/config": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
