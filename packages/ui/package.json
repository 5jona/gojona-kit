{
  "name": "@gojona/ui",
  "version": "0.3.1",
  "description": "Multi-theme Tailwind CSS v4 and Radix React UI component library with adaptive glassmorphism surfaces and swipeable tab pager.",
  "license": "MIT",
  "author": "5jona",
  "repository": {
    "type": "git",
    "url": "https://github.com/5jona/gojona-kit.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/5jona/gojona-kit#readme",
  "bugs": {
    "url": "https://github.com/5jona/gojona-kit/issues"
  },
  "keywords": [
    "ui",
    "react",
    "tailwindcss",
    "radix-ui",
    "glassmorphism",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme-tokens": {
      "source": "./src/theme/tokens.ts",
      "types": "./dist/theme/tokens.d.ts",
      "import": "./dist/theme/tokens.js",
      "default": "./dist/theme/tokens.js"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@gojona/config": "workspace:^",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
