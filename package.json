{
  "name": "gojona-kit",
  "private": true,
  "version": "0.1.1",
  "packageManager": "pnpm@12.22.0",
  "scripts": {
    "dev": "pnpm --filter @gojona/playground dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && node --test test/*.test.mjs",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "preview": "pnpm --filter @gojona/playground preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
