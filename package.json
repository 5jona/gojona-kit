{
  "name": "pochita-webui-kit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.22.0",
  "scripts": {
    "dev": "pnpm --filter @pochita/playground dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "preview": "pnpm --filter @pochita/playground preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
